<!DOCTYPE html>
<html lang="en">
  <head>
    <% seo_title = @seo_title || "Built by Bala | Freelance Web Developer in Sivakasi" %>
    <% seo_description = @seo_description || "Looking for a freelance web developer in Sivakasi? Bala Bharathi builds business websites, web applications, and custom software. Explore projects and get in touch." %>
    <% canonical_url = @canonical_url || "https://builtbybala.site/" %>
    <title><%= seo_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= seo_description %>">
    <meta name="theme-color" content="#5003c0">
    <link rel="canonical" href="<%= canonical_url %>">
    <meta property="og:title" content="<%= seo_title %>">
    <meta property="og:description" content="<%= seo_description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:site_name" content="Built by Bala">
    <meta property="og:image" content="https://builtbybala.site/portfolio/share-card-v1.png">
    <meta property="og:image:secure_url" content="https://builtbybala.site/portfolio/share-card-v1.png">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Built by Bala — Big ideas. Better landings. Websites and business software by Bala Bharathi in Sivakasi.">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="https://builtbybala.site/portfolio/share-card-v1.png">
    <meta name="twitter:title" content="<%= seo_title %>">
    <meta name="twitter:description" content="<%= seo_description %>">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://builtbybala.site/#website",
            "url": "https://builtbybala.site/",
            "name": "Built by Bala",
            "inLanguage": "en",
            "publisher": { "@id": "https://builtbybala.site/#person" }
          },
          {
            "@type": "Person",
            "@id": "https://builtbybala.site/#person",
            "name": "Bala Bharathi",
            "url": "https://builtbybala.site/",
            "jobTitle": "Freelance Web Developer",
            "description": "The developer behind Built by Bala, building websites, web applications, and custom business software for businesses in Sivakasi and beyond.",
            "homeLocation": { "@type": "Place", "name": "Sivakasi, Tamil Nadu, India" }
          }
        ]
      }
    </script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/portfolio/favicon.svg" type="image/svg+xml">
    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_javascript_tag(action_name == "newbilling" ? "case-study.js" : "portfolio.jsx") %>
  </head>
  <body class="portfolio-body">
    <%= yield %>
  </body>
</html>
